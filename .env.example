# ---- Talk brain (everyday questions) ----
# OpenRouter: one key reaches every model. When set, talk mode uses it instead of Claude.
OPENROUTER_API_KEY=
# Which model answers talk questions (pick with the /bench page, then set it here so it survives redeploys)
TALK_MODEL=google/gemini-3.8-flash
# Web search engine for talk mode: parallel (cheapest), exa, perplexity, auto
TALK_SEARCH_ENGINE=parallel
# Thinking effort for talk mode: low (default), minimal, none
TALK_REASONING=low
# Force the old Claude talk path instead: BRAIN=claude
# BRAIN=openrouter

# ---- Crypto watch ----
# Free CoinGecko "demo" key (coingecko.com/en/api). Avoids rate limits on shared cloud servers.
COINGECKO_API_KEY=
# Scheduled briefs, local time (TZ). Use "off" to skip one.
CRYPTO_BRIEF_MORNING=08:00
CRYPTO_BRIEF_MIDDAY=12:30
CRYPTO_BRIEF_EVENING=18:30
# Midday check only runs if a top coin moves this many percent in 24h (watchlist coins: two thirds of it)
CRYPTO_ALERT_PCT=6
# Optional phone alerts: install the free ntfy app, subscribe to a long random topic name, put it here
NTFY_TOPIC=
# Telegram alerts (preferred): create a bot with @BotFather, put its token here, then send the bot any message once
# Pushover alerts (best): notification-only app with your own sound
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_SOUND=jarvis
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Self-repair brain (workshop mode, always Claude) ----
# Option A: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Option B: use your Claude subscription — run `npx @anthropic-ai/claude-code setup-token` and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Voice ----
# Fish Audio (closest to the movie Jarvis). If set, it is used instead of ElevenLabs.
FISH_API_KEY=
FISH_VOICE_ID=b841fc010afe43efa1b9fb702832988d
ELEVENLABS_API_KEY=
# Default is "Daniel" (calm, polished British male). Swap for any voice ID from your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Behaviour ----
WAKE_WORD=jarvis
USER_TITLE=sir
# Claude models: talk (only used when BRAIN=claude) and self-repair
# JARVIS_MODEL=haiku
# JARVIS_CODE_MODEL=sonnet
# Let Jarvis run shell commands and edit files in ./workspace (off by default)
JARVIS_ALLOW_SHELL=0
# Auto-run config/briefing.md every N minutes (0 = off)
BRIEFING_EVERY_MINUTES=0
PORT=7777
# REQUIRED when hosted online: PIN you type once per device to unlock Jarvis
JARVIS_PIN=

# ---- Self-repair (lets Jarvis change and redeploy its own code) ----
# GitHub fine-grained token: only the Jarvis-2.0 repo, permission "Contents: Read and write"
GITHUB_TOKEN=
GITHUB_REPO=Elliot-H/Jarvis-2.0

# ---- Spending guard ----
# Hard cap for the whole day (Jarvis refuses further AI requests once reached)
DAILY_BUDGET_USD=2
# Monthly caps: all AI spend together, and self-repair on its own
MONTHLY_BUDGET_USD=10
WORK_MONTHLY_BUDGET_USD=5
# Max spend for one run of the /bench model test
BENCH_BUDGET_USD=1
# Per-request caps: a normal question / one self-repair job
CHAT_BUDGET_USD=0.05
WORK_BUDGET_USD=0.75
TZ=America/New_York

# Google Calendar (service account): paste the whole JSON key file as one line, and your calendar's id (usually your Gmail address)
GOOGLE_CALENDAR_KEY=
GOOGLE_CALENDAR_ID=
# Optional: colour meanings that survive a wipe of data/, e.g. {"6":"job","default":"personal"}
CALENDAR_COLOR_MEANINGS=
# Spotify (developer.spotify.com/dashboard). Approve once at /api/spotify/login. Premium needed for playback control.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Bluetooth speaker name to connect on "start" (default Rockville) and the Tasker task that connects it (default JarvisBT)
BT_SPEAKER_NAME=Rockville
TASKER_BT_TASK=JarvisBT
TASKER_BT_OFF_TASK=JarvisBTOff
TASKER_BT_DISCONNECT_TASK=JarvisBTDisconnect
